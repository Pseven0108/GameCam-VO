{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task004C-B S1 schedule schema",
  "description": "SCHEMA ONLY. No natural schedule has been recorded. Full numeric pose/target/weight/U payloads are deliberately excluded; their optional diagnostics belong in a separate audit stream.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schedule_id",
    "mode",
    "producer_arm",
    "producer_D",
    "init_D",
    "local_W",
    "local_U",
    "C0_content_sha256",
    "input_manifest_sha256",
    "source_manifest_sha256",
    "protocol_sha256",
    "last_initialization_rgb_id",
    "next_input_index",
    "end_rgb_id",
    "scope",
    "events",
    "complete",
    "footer"
  ],
  "properties": {
    "schema": {
      "const": "GAMECAM_TASK004C_B_EXECUTABLE_SCHEDULE_V1"
    },
    "schedule_id": {
      "const": "S1"
    },
    "mode": {
      "const": "NATURAL_RECORDED"
    },
    "producer_arm": {
      "const": "B1"
    },
    "producer_D": {
      "const": 1
    },
    "init_D": {
      "const": 0
    },
    "local_W": {
      "const": 1
    },
    "local_U": {
      "const": 1
    },
    "C0_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "last_initialization_rgb_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 486
    },
    "next_input_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 486
    },
    "end_rgb_id": {
      "const": 487
    },
    "scope": {
      "const": "FRONTEND_AND_FINAL_GRAPH_AND_FILLER_DISCRETE_EVENTS"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "complete": {
      "const": true
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_count",
        "frame_count_after_C0",
        "native_ba_call_count",
        "event_chain_sha256",
        "final_control_state_sha256",
        "failure_count"
      ],
      "properties": {
        "event_count": {
          "type": "integer",
          "minimum": 1
        },
        "frame_count_after_C0": {
          "type": "integer",
          "minimum": 1
        },
        "native_ba_call_count": {
          "type": "integer",
          "minimum": 1
        },
        "event_chain_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "final_control_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "failure_count": {
          "const": 0
        }
      }
    }
  },
  "$defs": {
