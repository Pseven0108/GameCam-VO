        "lm": {
          "type": "number",
          "minimum": 0
        },
        "ep": {
          "type": "number",
          "minimum": 0
        },
        "graph_EP": {
          "type": "number",
          "minimum": 0
        },
        "learning_rate": {
          "type": "number",
          "minimum": 0
        },
        "weight_decay": {
          "type": "number",
          "minimum": 0
