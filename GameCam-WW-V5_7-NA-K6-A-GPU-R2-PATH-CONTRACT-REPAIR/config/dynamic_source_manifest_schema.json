{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameCam verified dynamic source manifest",
  "type": "object",
  "required": [
    "schema",
    "strategy",
    "sources",
    "selected_model_entrypoints",
    "allow_project_bytecode"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "gamecam-dynamic-source-manifest-v1"
    },
    "strategy": {
      "const": "VERIFIED_SOURCE_ONLY"
    },
    "allow_project_bytecode": {
      "const": false
    },
    "selected_model_entrypoints": {
      "type": "object",
      "required": [
        "Metric3D",
        "FiT3D"
      ],
      "additionalProperties": false,
      "properties": {
        "Metric3D": {
          "const": "metric3d_vit_large"
        },
        "FiT3D": {
          "const": "dinov2_reg_small_fine"
        }
      }
    },
    "unused_branches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^baselines/droid_w/prior_sources/(Metric3D|FiT3D)/.*\\.py$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
